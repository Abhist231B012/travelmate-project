# Server configuration
PORT=5000
NODE_ENV=development

# MongoDB connection string (local MongoDB or MongoDB Atlas)
# Local:  mongodb://127.0.0.1:27017/travel-around
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/travel-around
MONGO_URI=mongodb://127.0.0.1:27017/travel-around

# Session signing secret - use a long random string (required in production)
SESSION_SECRET=replace_with_a_long_random_string

# Extra allowed frontend origins for CORS (comma separated, optional)
# Example: https://your-app.onrender.com
CLIENT_URL=
