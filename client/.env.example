# Google Gemini API key (used only by the client for AI itinerary generation)
VITE_GOOGLE_GEMINI_AI_API_KEY=

# Gemini model to use (optional, defaults to gemini-2.0-flash)
VITE_GEMINI_MODEL=gemini-2.0-flash

# Optional: Google Places key if you enable the Google Places autocomplete
VITE_GOOGLE_PLACES_API_KEY=
